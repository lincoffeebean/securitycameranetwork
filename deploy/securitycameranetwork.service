[Unit]
Description=Security Camera Network FastAPI server
After=network.target

[Service]
User=expiredsession
Group=expiredsession
WorkingDirectory=/home/expiredsession/securitycameranetwork/server
Environment=PATH=/home/expiredsession/securitycameranetwork/server/.venv/bin
ExecStart=/home/expiredsession/securitycameranetwork/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
